# ============================================================
# Tora for Windows — configuration
# ============================================================
# Copy this file to .env and paste your key below.
# Tora runs entirely on Google's Gemini models.

# ── The one required setting ─────────────────────────────────
# Get a free key: https://aistudio.google.com/app/apikey
# GEMINI_API_KEY is accepted as an alias, since that is what
# AI Studio's copy button calls it.
GOOGLE_API_KEY=

# ── How Tora talks ─────────────────────────────────────────
# realtime  (default) one websocket to gemini-3.8-live — audio in,
#           audio out, tool calls. First word in about 1.5 s.
# cascade   transcribe → text model → synthesise speech. Several
#           seconds slower. Tora falls back to this by itself if
#           the websocket can't be opened; set it here to force it.
TORA_CONVERSATION=realtime

# Which prebuilt Gemini voice speaks. Every voice speaks every
# language, so this does not change when the reply language does.
# Zephyr Puck Charon Kore Fenrir Leda Orus Aoede Callirrhoe
# Autonoe Enceladus Iapetus
GEMINI_TTS_VOICE=Zephyr

# ── Models per job ───────────────────────────────────────────
# Defaults shown. Override only if you know you want to.
#
#   REALTIME   the conversation itself: hears you, decides which
#              tool to call, speaks the reply in its own voice
#   PLANNER    breaks "show me how to…" into steps. Deliberate —
#              10-20 s, which is why Tora says "let me work that
#              out" while it thinks
#   VISION_FAST  the cheap glance. First pass on any screen question
#   VISION_DEEP  the careful look — charts, chessboards, code,
#                handwriting. Advice questions go straight here
#   STT        dictation and wake-word checks
#   TTS        the cascaded fallback voice
#   EMBED      memory and document recall
GEMINI_REALTIME_MODEL=gemini-3.8-live
GEMINI_PLANNER_MODEL=gemini-3.1-pro-preview
GEMINI_VISION_FAST=gemini-3.8-flash
GEMINI_VISION_DEEP=gemini-3.1-pro-preview
GEMINI_STT_MODEL=gemini-3.5-transcribe-live
GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
GEMINI_EMBED_MODEL=gemini-embedding-001

# ── Web search (for grounding on live info) ──────────────────
# Leave empty to use DuckDuckGo (free, no key).
TAVILY_API_KEY=

# ── App settings ─────────────────────────────────────────────
# Hotkey to talk to Tora. Hold it and speak, or tap it once and
# speak — either way Tora answers when you stop talking.
TORA_HOTKEY=ctrl+win

# Microphone mode:
#   hotkey  (default) mic opens only while you're asking something
#   ambient           mic stays open and listens for the wake word
#
# A local energy gate decides what counts as speech, and only those
# clips are sent to be checked for the wake word — never a
# continuous stream, and nothing at all while the room is quiet.
# hotkey mode does not open the microphone until you press the key.
TORA_MIC_MODE=hotkey

# How long the hotkey may be held before it counts as hold-to-talk
# rather than a tap. Below this, releasing it doesn't stop recording.
TORA_TAP_MAX_SECONDS=0.6

# Language Tora transcribes in. Empty = detect per utterance.
# Pin one (e.g. de, hi, es) if you speak a code-mixed language and
# the transcript keeps flipping between them.
STT_LANGUAGE=

# Language Tora replies in. Empty = match whatever you spoke.
RESPONSE_LANGUAGE=

# ── Agent workforce: OpenAI-compatible provider ─────────────────────────────
# Any OpenAI-compatible endpoint (a gateway, a local llama.cpp server, or
# api.openai.com itself). The agent workforce uses this for planning and
# for the worker's tool-calling loop.
#   NOTE: some gateways answer /chat/completions with text/event-stream
#   even when you do not ask to stream. The client reassembles SSE either way.
# TORA_OMNIROUTE_API_KEY=sk-...
# TORA_OMNIROUTE_BASE_URL=https://your-gateway.example/v1
